# StoryLingo Supabase configuration
#
# 1. Open your Supabase project dashboard.
# 2. Go to Project Settings -> API.
# 3. Copy "Project URL" into SUPABASE_URL.
# 4. Copy the public "anon" key into SUPABASE_ANON_KEY.
# 5. Put real values in a local .env file or in your hosting provider secrets.
#
# Do not commit real keys to GitHub.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Vite-prefixed names are also supported if your hosting provider prefers them:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
